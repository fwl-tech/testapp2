# Anthropic (required — powers the billing agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# App access — single shared password for this personal app.
# Leave unset for open access during local dev.
APP_PASSWORD=

# Gmail (required to actually send invoices/reminders — see docs/SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=you@yourdomain.com

# Secret required in the `x-cron-secret` header to hit /api/agent/cron
CRON_SECRET=

# Where the SQLite database file lives. On Railway, mount a volume at this path
# so invoice data survives deploys.
DB_PATH=./data/app.db
